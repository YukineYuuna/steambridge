{
  "name": "steambridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A macOS launcher for running compatible Windows Steam games without a virtual machine.",
  "main": "electron/main.cjs",
  "author": "SteamBridge contributors",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:ui": "tsc -b && vite build",
    "build": "npm run build:ui && electron-builder",
    "build:mac": "npm run build:ui && electron-builder --mac --publish never",
    "lint": "eslint .",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run lint && npm run test && npm run build:ui"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.41.0",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "dev.steambridge.app",
    "productName": "SteamBridge",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.games",
      "minimumSystemVersion": "12.0",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "SteamBridge ${version}",
      "window": {
        "width": 560,
        "height": 380
      }
    }
  }
}
